# Copy to backend/.env and fill in what you have. Everything is optional:
# with no AI provider the app runs fully offline (rules + curated translations).

# Staff login for the surgeon dashboard
SURGEON_PIN=2468
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# AI provider: none | gemini | azure | openai | anthropic
# Recommended (free): Google Gemini. Get a key at aistudio.google.com/apikey (no card), then:
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=your-key
# Default model gemini-3.5-flash-lite (about 15 requests/minute, 500/day free). Set LLM_MODEL to change it.
# Safety never depends on the AI: red-flag rules always run, and after a rate limit the app
# uses its offline rules for LLM_COOLDOWN_S seconds (default 60).
LLM_PROVIDER=none
GEMINI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Any OpenAI-compatible endpoint (OpenAI, Ollama at http://localhost:11434/v1, vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=

# Anthropic (LLM_MODEL defaults to claude-opus-5-5)
ANTHROPIC_API_KEY=

# Optional: natural voices for Kannada, Hindi, Tamil and Indian English, tried in this order.
# Best free option with an NVIDIA GPU: run tts-local/server.py (Indic Parler-TTS). It is found
# automatically on 127.0.0.1:8010; set a URL only for another host/port, or leave empty to disable.
# LOCAL_TTS_URL=auto
# Recommended (free): Azure AI Speech, Free F0 tier = 0.5M neural characters/month.
# Students: azure.microsoft.com/free/students (no credit card) -> create a "Speech" resource,
# pricing tier "Free F0", region Central India -> copy "Key 1" here.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# AZURE_VOICES=hi=hi-IN-SwaraNeural,kn=kn-IN-SapnaNeural,ta=ta-IN-PallaviNeural,en=en-IN-NeerjaNeural
# TTS_PACE=0.92
# Alternative (paid): Sarvam AI Bulbul
SARVAM_API_KEY=

# Database (SQLite by default; Postgres/Supabase also work)
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
SEED_DEMO_DATA=true
CLINIC_TIMEZONE=Asia/Kolkata
